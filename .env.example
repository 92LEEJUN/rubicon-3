# 루트 .env.example — 전체 런타임 토글 문서화(설명 + 안전 기본값).
# 실제 값은 각 서브시스템의 .env 로 복사해 채운다(예: backend/.env). .env 는 gitignore 된다.
#
# 핵심 원칙: **기본 off = 기존(결정적) 동작**. 새 기능은 토글 뒤에 두고,
# 토글이 off면 회귀 없이 기존 동작과 동일해야 한다(스트랭글러). 비워두면 off 로 간주.

# ── LLM(실 LLM 경로) ─────────────────────────────────────────────────────────
# OpenAI API 키 — LLM 경로(LLM_BACKED=1) 사용 시 필요. 비우면 실 LLM 미사용.
# 저장소/코드에 키를 직접 커밋하지 말 것. 실 LLM은 CI에 없다 → 수동 검증.
OPENAI_API_KEY=

# 1/true → 채팅 응답을 LLM 자연어 생성(tool-loop). 비우면 결정적(룰베이스+Mock) 경로.
LLM_BACKED=

# ── 오케스트레이터 경로 선택(기본 off = 결정적) ─────────────────────────────
# 1/true → capability 오케스트레이터 경로(§9.2). LLM_BACKED on이면 LLM 플래너, off면 규칙 폴백.
CAPABILITY_ORCH=

# 1/true → 슈퍼바이저-워커 멀티에이전트 경로(LLM_BACKED on 위에서 동작).
MULTIAGENT=

# ── 신원/멀티테넌트(기본 off = 기본 사용자) ─────────────────────────────────
# 1/true → Principal/게스트 신원 해석. off면 기본 사용자로 폴백(게스트 커밋 게이트 없음).
MULTITENANT=

# ── 상태 영속(기본 memory = 인메모리, 기존 동작) ────────────────────────────
# memory | db. db 면 SQLITE_PATH 의 SQLite 파일에 상태를 영속한다.
PERSISTENCE=memory
# PERSISTENCE=db 일 때 사용할 SQLite 파일 경로.
SQLITE_PATH=rubicon.db

# ── 서비스 간 연결 ───────────────────────────────────────────────────────────
# BFF → BE 내부 API 베이스 URL(BFF 가 BackendClient로 호출).
BE_BASE_URL=http://localhost:8001
